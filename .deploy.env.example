# Values for Build/deploy-mittwald.sh; copy to .deploy.env (git-ignored).
# The mittwald project and its container stack ("mw stack list -p <project>";
# "mw stack create -p <project> -d typo3-provenance-demo" makes one).
PROJECT_ID=
STACK_ID=
DEMO_SITE_URL=https://demo.cms-provenance.org/
# Any long random string, e.g. from "openssl rand -hex 24". Keep it: the
# database volume was created with it.
DEMO_DB_PASSWORD=
